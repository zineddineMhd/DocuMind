# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais versionner .env.

# --- Gemini (https://aistudio.google.com/) : côté serveur uniquement ---
GEMINI_API_KEY=remplacer_par_votre_cle
# Vérifier les modèles accessibles sur AI Studio : ils évoluent (gemini-2.5-flash n'est plus ouvert aux nouvelles clés).
GEMINI_MODEL=gemini-3.5-flash
# Modèles de secours essayés dans l'ordre si le principal est surchargé (503), hors quota (429) ou retiré (404)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# 0 = désactive la « réflexion » (réponses plus rapides) ; laisser vide pour le défaut du modèle
GEMINI_THINKING_BUDGET=0

# --- Sécurité ---
JWT_SECRET=longue_valeur_aleatoire_a_generer
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Stockage (défauts locaux : SQLite + dossiers backend/data/) ---
# DATABASE_URL=postgresql+psycopg://documind:password@db:5432/documind
# CHROMA_PATH=/app/data/chroma
# UPLOAD_DIR=/app/data/uploads

# --- Limites ---
MAX_UPLOAD_MB=20
STORAGE_QUOTA_MB=1024
RATE_LIMIT_CHAT_PER_MIN=20

# --- RAG ---
# local (Sentence Transformers, recommandé) | gemini (gemini-embedding-001)
EMBEDDING_BACKEND=local
# vide = modèle affiné backend/models/documind-e5-small-ft s'il existe, sinon intfloat/multilingual-e5-small
EMBEDDING_MODEL=
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6
HYBRID_SEARCH=true
# optionnel (plus précis, plus lent sur CPU) : cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL=
